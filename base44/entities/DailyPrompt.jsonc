{
  "name": "DailyPrompt",
  "type": "object",
  "properties": {
    "prompt_text": {
      "type": "string",
      "description": "The reflection prompt"
    },
    "category": {
      "type": "string",
      "enum": [
        "awareness",
        "emotion",
        "identity",
        "clarity",
        "presence"
      ],
      "description": "Prompt category"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Is this prompt in rotation"
    },
    "display_order": {
      "type": "number",
      "description": "Optional ordering"
    }
  },
  "required": [
    "prompt_text",
    "category"
  ]
}