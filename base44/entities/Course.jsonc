{
  "name": "Course",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Course title"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "subtitle": {
      "type": "string",
      "description": "Course subtitle/tagline"
    },
    "type": {
      "type": "string",
      "enum": [
        "Toolkit Module",
        "Webinar",
        "Audio-Based Program",
        "Training Program",
        "Other"
      ],
      "description": "Course type"
    },
    "duration": {
      "type": "string",
      "description": "Estimated duration (e.g., '2 hours', '4 weeks')"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "Intro",
        "Intermediate",
        "Deep Work"
      ],
      "description": "Difficulty level"
    },
    "short_description": {
      "type": "string",
      "description": "Short description for listings"
    },
    "long_description": {
      "type": "string",
      "description": "Full course description"
    },
    "learning_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What you'll learn (3-7 bullet points)"
    },
    "thumbnail": {
      "type": "string",
      "description": "Course thumbnail image URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "description": "Publication status"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "clients_only"
      ],
      "default": "public",
      "description": "Who can see this course"
    },
    "product_linkage": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Stripe product IDs that unlock this course"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Course IDs required before accessing this one"
    },
    "attached_resource_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of Resource entities attached to entire course"
    },
    "certificate_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Issue certificate upon completion"
    },
    "certificate_template": {
      "type": "string",
      "enum": [
        "standard",
        "professional",
        "elegant"
      ],
      "default": "standard",
      "description": "Certificate design template"
    },
    "instructor_name": {
      "type": "string",
      "description": "Name shown on certificate"
    },
    "instructor_title": {
      "type": "string",
      "description": "Title shown on certificate"
    },
    "instructor_signature": {
      "type": "string",
      "description": "Signature image URL"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Display order for sorting in Course Manager"
    }
  },
  "required": [
    "title",
    "slug",
    "type",
    "status"
  ]
}