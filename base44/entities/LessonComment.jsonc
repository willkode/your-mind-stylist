{
  "name": "LessonComment",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "Reference to Lesson entity"
    },
    "course_id": {
      "type": "string",
      "description": "Reference to Course entity"
    },
    "user_email": {
      "type": "string",
      "description": "User who posted the comment"
    },
    "user_name": {
      "type": "string",
      "description": "Display name of commenter"
    },
    "comment_text": {
      "type": "string",
      "description": "The comment content"
    },
    "parent_comment_id": {
      "type": "string",
      "description": "ID of parent comment if this is a reply"
    },
    "is_question": {
      "type": "boolean",
      "default": false,
      "description": "Is this marked as a question"
    },
    "is_answered": {
      "type": "boolean",
      "default": false,
      "description": "Has this question been answered"
    },
    "answered_by": {
      "type": "string",
      "description": "Email of person who answered"
    },
    "answered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When question was marked as answered"
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "description": "Is this comment pinned by instructor"
    },
    "likes": {
      "type": "number",
      "default": 0,
      "description": "Number of likes"
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who liked this"
    }
  },
  "required": [
    "lesson_id",
    "course_id",
    "comment_text"
  ]
}