{
  "name": "Resource",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Resource title"
    },
    "description": {
      "type": "string",
      "description": "Resource description"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "pdf",
        "video",
        "audio",
        "image",
        "link",
        "worksheet",
        "text"
      ],
      "description": "Type of resource"
    },
    "file_url": {
      "type": "string",
      "description": "File or link URL"
    },
    "thumbnail": {
      "type": "string",
      "description": "Thumbnail image URL"
    },
    "file_size": {
      "type": "string",
      "description": "Human-readable file size (e.g., '2.5 MB')"
    },
    "access_level": {
      "type": "string",
      "enum": [
        "public",
        "authenticated",
        "product_gated"
      ],
      "default": "public",
      "description": "Who can access this resource"
    },
    "product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Stripe product IDs that unlock this resource (for product_gated)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Worksheets",
        "Guides",
        "Audio Sessions",
        "Videos",
        "Templates",
        "Graphics",
        "Tools",
        "Other"
      ],
      "description": "Resource category"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for filtering and search"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "description": "Publication status"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Show in featured section"
    },
    "download_count": {
      "type": "number",
      "default": 0,
      "description": "Total downloads"
    },
    "view_count": {
      "type": "number",
      "default": 0,
      "description": "Total views"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "title",
    "resource_type",
    "access_level"
  ]
}